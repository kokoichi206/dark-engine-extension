{
  "name": "dark-engine-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify:sites": "pnpm build && node scripts/verify-sites.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
